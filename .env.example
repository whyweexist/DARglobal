APP_ENV=development
DATABASE_URL=sqlite:////data/estate.db
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
FREE_MODELS_ONLY=true
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_DOMAIN=localhost
API_RATE_LIMIT_PER_MINUTE=12
# Optional scraping engine: httpx (default) or scrapling
SCRAPER_ENGINE=httpx
# Rebuild Docker image with Scrapling HTTP/CSS extras when true
ENABLE_SCRAPLING=false
SCRAPE_ON_BOOT=true
SCRAPE_REFRESH_HOURS=24
CRAWL_MAX_PAGES=50
CRAWL_DELAY_SECONDS=2
# DarGlobal is processed only when robots and published site permissions allow it.
DARGLOBAL_ENABLED=true
# Wasalt restrictions mean this is false without independent documented authorization.
WASALT_AUTHORIZED=false
WASALT_AUTHORIZATION_REFERENCE="Authorized technical assessment; public listing extraction under https://wasalt.sa/llms.txt"
# Bounded public category and listing collection (only for an authorized operator).
WASALT_DETAILS_PER_CATEGORY=3
WASALT_MAX_CATEGORY_PAGES=3
WASALT_MAX_RESPONSE_BYTES=5000000
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
CHUNK_TARGET_TOKENS=400
CHUNK_MAX_TOKENS=600
CHUNK_OVERLAP_TOKENS=60
RAG_MAX_CONTEXT_CHARS=12500
RETRIEVAL_TOP_K=6
RAG_LIVE_SEARCH=true
AGENT_MAX_LIVE_PAGES=3
AGENT_MAX_SECONDS=45
LLM_MAX_TOKENS=1200
CHAT_DEADLINE_SECONDS=100
LLM_TIMEOUT_SECONDS=40
MODEL_CATALOG_TTL_SECONDS=3600

# Optional third-party Wasalt data provider; requires actual approval and a billing-aware opt-in.
# inherit = global SCRAPER_ENGINE; httpx / scrapling / apify are supported.
WASALT_ENGINE=inherit
APIFY_ENABLED=false
APIFY_TOKEN=
# Enable only if public chatbot users may trigger metered actor runs.
APIFY_LIVE_SEARCH=false
APIFY_MAX_LISTINGS=40
APIFY_LIVE_MAX_LISTINGS=8
APIFY_MAX_RUNS_PER_DAY=4
APIFY_MAX_CHARGE_USD=0.25
APIFY_TIMEOUT_SECONDS=90
