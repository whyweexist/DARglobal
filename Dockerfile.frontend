# syntax=docker/dockerfile:1.7
FROM node:22-alpine AS builder
WORKDIR /work
RUN npm install -g pnpm@9.15.4
COPY frontend/package.json ./package.json
RUN pnpm install --no-frozen-lockfile
COPY frontend/ ./
ARG API_URL_INTERNAL=http://api:8000
ENV API_URL_INTERNAL=${API_URL_INTERNAL} NEXT_TELEMETRY_DISABLED=1
RUN pnpm build
FROM node:22-alpine
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0 NEXT_TELEMETRY_DISABLED=1
WORKDIR /work
COPY --from=builder /work/.next/standalone ./
COPY --from=builder /work/.next/static ./.next/static
RUN addgroup -S estate && adduser -S estate -G estate && chown -R estate:estate /work
USER estate
EXPOSE 3000
CMD ["node","server.js"]
