# syntax=docker/dockerfile:1.7
FROM python:3.12-slim AS base
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HF_HOME=/home/estate/.cache/huggingface UV_HTTP_TIMEOUT=120 UV_HTTP_RETRIES=5
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 ca-certificates && rm -rf /var/lib/apt/lists/*
# uv >=0.10 supports --torch-backend=cpu for CPU-only PyTorch wheels.
COPY --from=ghcr.io/astral-sh/uv:0.10.0 /uv /bin/uv
WORKDIR /app/backend
COPY backend/pyproject.toml ./pyproject.toml
COPY backend/app ./app
COPY backend/migrations ./migrations
COPY backend/alembic.ini ./alembic.ini
COPY scripts /app/scripts
# Evaluation labels are optional, and Git/ZIP omit empty directories.
# Create the mount point rather than requiring an absent build-context path.
RUN mkdir -p /app/evaluations/retrieval
# Opt-in feature: lightweight Scrapling HTTP/CSS fetcher (no browser downloads).
ARG ENABLE_SCRAPLING=false
# Linux x86_64 PyPI torch defaults to CUDA-enabled wheels, which download huge NVIDIA
# libraries that are unused by this CPU-only embedding service. On ARM64 the PyPI
# PyTorch wheel is CPU-only; the CPU index is not required there.
ARG TARGETARCH
RUN set -eu; \
    if [ "${TARGETARCH:-$(uname -m)}" = "amd64" ] || [ "${TARGETARCH:-$(uname -m)}" = "x86_64" ]; then \
      export UV_TORCH_BACKEND=cpu; \
    fi; \
    if [ "$ENABLE_SCRAPLING" = "true" ]; then \
      uv pip install --system --no-cache '.[scrapling]'; \
    else \
      uv pip install --system --no-cache .; \
    fi; \
    python -c 'import torch; assert torch.version.cuda is None, "A CUDA-enabled PyTorch build was installed"; print("CPU-only PyTorch:", torch.__version__)'; \
    uv pip check --system
RUN useradd --uid 10001 --create-home estate && mkdir -p /data /home/estate/.cache/huggingface && chown -R estate:estate /data /home/estate /app
USER estate
ENV PYTHONPATH=/app/backend PORT=8000
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
