{
  "name": "Estate Intelligence / Research Studio",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {"version": "22"},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/common-utils:2": {}
  },
  "postCreateCommand": "python -m pip install --user uv && npm install --global pnpm@9.15.4 && (test -f .env || cp .env.example .env)",
  "forwardPorts": [3000, 8000],
  "portsAttributes": {"3000": {"label": "ESTATE / Research Studio", "onAutoForward": "notify"}},
  "customizations": {"vscode": {"extensions": ["ms-python.python", "ms-python.vscode-pylance", "charliermarsh.ruff", "bradlc.vscode-tailwindcss", "esbenp.prettier-vscode"]}}
}
