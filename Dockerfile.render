# Build the browser application as static files for the single-container service.
FROM node:22-alpine AS frontend
WORKDIR /work/frontend
RUN npm install --global pnpm@9.15.4
COPY frontend/package.json ./
RUN pnpm install --no-frozen-lockfile
COPY frontend/ ./
ENV STATIC_EXPORT=true NEXT_TELEMETRY_DISABLED=1
RUN pnpm build

# The HTTP embedding provider keeps PyTorch and SentenceTransformers out of this image.
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app/backend \
    DATABASE_URL=sqlite:////data/estate.db SERVE_STATIC_DIR=/app/static \
    EMBEDDING_PROVIDER=gemini EMBEDDING_MODEL=gemini-embedding-001
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app/backend
COPY backend/pyproject.toml ./pyproject.toml
COPY backend/app ./app
COPY backend/migrations ./migrations
COPY backend/alembic.ini ./alembic.ini
RUN pip install --no-cache-dir .
COPY --from=frontend /work/frontend/out /app/static
RUN useradd --uid 10001 --create-home estate \
    && mkdir -p /data \
    && chown -R estate:estate /app /data
USER estate
EXPOSE 8000
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1"]
