APP_ENV=production
DATABASE_URL=sqlite:////data/estate.db
APP_DOMAIN=estate.example.com
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
FREE_MODELS_ONLY=true
ALLOWED_ORIGINS=https://estate.example.com
API_RATE_LIMIT_PER_MINUTE=10
DARGLOBAL_ENABLED=true
WASALT_AUTHORIZED=false
WASALT_AUTHORIZATION_REFERENCE=
# Bounded public category and listing collection (only for an authorized operator).
WASALT_DETAILS_PER_CATEGORY=3
WASALT_MAX_CATEGORY_PAGES=3
WASALT_MAX_RESPONSE_BYTES=5000000
# Optional scraping engine: httpx (default) or scrapling
SCRAPER_ENGINE=httpx
# Rebuild Docker image with Scrapling HTTP/CSS extras when true
ENABLE_SCRAPLING=false
SCRAPE_ON_BOOT=false
RAG_LIVE_SEARCH=true

# Optional third-party Wasalt data provider; requires actual approval and a billing-aware opt-in.
# inherit = global SCRAPER_ENGINE; httpx / scrapling / apify are supported.
WASALT_ENGINE=httpx
APIFY_ENABLED=false
APIFY_TOKEN=
# Enable only if public chatbot users may trigger metered actor runs.
APIFY_LIVE_SEARCH=false
APIFY_MAX_LISTINGS=40
APIFY_LIVE_MAX_LISTINGS=8
APIFY_MAX_RUNS_PER_DAY=4
APIFY_MAX_CHARGE_USD=0.25
APIFY_TIMEOUT_SECONDS=90

# Latency budgets; no reduction in retrieval depth or evidence validation.
LLM_TOTAL_SECONDS=60
EMBEDDING_CPU_THREADS=2
SOURCE_ACCESS_COOLDOWN_SECONDS=300
AGENT_MAX_SECONDS=30
LLM_TIMEOUT_SECONDS=30
