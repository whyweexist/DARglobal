APP_ENV=production
DATABASE_URL=sqlite:////data/estate.db
APP_DOMAIN=estate.example.com
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
FREE_MODELS_ONLY=true
ALLOWED_ORIGINS=https://estate.example.com
API_RATE_LIMIT_PER_MINUTE=10
DARGLOBAL_ENABLED=true
WASALT_AUTHORIZED=false
WASALT_AUTHORIZATION_REFERENCE=
# Optional scraping engine: httpx (default) or scrapling
SCRAPER_ENGINE=httpx
# Rebuild Docker image with Scrapling HTTP/CSS extras when true
ENABLE_SCRAPLING=false
SCRAPE_ON_BOOT=false
RAG_LIVE_SEARCH=true
